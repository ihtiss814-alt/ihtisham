# Copy these names into Replit Secrets for a new clone.
# Do not commit a populated .env file.

# Frontend / Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WHATSAPP_NUMBER=
VITE_CLOUDINARY_CLOUD_NAME=

# Backend / Express
PORT=8080
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_PASSWORD=

# SUPABASE_SERVICE_ROLE_KEY is intentionally not used by this app.
# SUPABASE_PASSWORD is a dashboard login password, not an app setting.