modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 4173
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 24102
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start backend"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ensure-dependencies.sh pnpm --filter @workspace/wazir-trading run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ensure-dependencies.sh env PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[userenv]

[userenv.shared]
CLOUDINARY_CLOUD_NAME = "txb1wiw1"
VITE_CLOUDINARY_CLOUD_NAME = "txb1wiw1"
VITE_SUPABASE_URL = "https://aphxjblbafyxobafjmot.supabase.co"
